MONGOOSE_URL=mongodb://127.0.0.1:27017/partner_application
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000

# Configure SMTP on the server. Never send these values to the browser or store them in MongoDB.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-username
MAIL_PASS=your-smtp-password
MAIL_FROM="BizMatch <no-reply@example.com>"
