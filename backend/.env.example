MONGOOSE_URL=mongodb://127.0.0.1:27017/partner_application
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000

# Configure SMTP on the server. Never send these values to the browser or store them in MongoDB.
# Gmail requires a Google App Password (with 2-Step Verification enabled), not your account password.
# Ethereal is for preview/testing only and does not deliver messages to recipients.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your-account@gmail.com
MAIL_PASS=your-google-app-password
MAIL_FROM="BizMatch <your-account@gmail.com>"
